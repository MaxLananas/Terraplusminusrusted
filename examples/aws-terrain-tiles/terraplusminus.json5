// Live AWS Terrain Tiles (the upstream default world layers) fetched over plain HTTP, with no
// dependency on curl. Tiles are cached on disk under ./tile-cache.
// OpenStreetMap features and trees are off to keep this example free of HTTPS: their default
// servers (https://cloud.daporkchop.net/gis/osm/0/ and .../gis/treecover2000/) are fetched
// through network.https_command (the system curl) when enabled. Without curl, point
// openstreetmap.servers or a copy of tree_cover.json5 (elevation.tree_cover_config) at a
// plain-HTTP or mirrored copy.
{
    "world": {"min_y": -2032, "height": 4064},
    "network": {
        "plain_http_hosts": ["s3.amazonaws.com"],
        "cache_directory": "tile-cache",
        "cache_max_bytes": 4294967296,
    },
    "openstreetmap": {"enabled": false},
    "generate_trees": false,
}
