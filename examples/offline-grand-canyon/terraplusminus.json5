// Offline configuration over the repository's single terrarium fixture tile (zoom 12,
// western Grand Canyon). Every other tile reports missing, which generates ocean there.
// There is no offline OpenStreetMap data for this area, so OSM features are turned off.
{
    "terrain_offset": {"x": 0, "y": 0, "z": 0},
    "biomes": {"use_dataset": true, "biome": "minecraft:plains"},
    "surface_material": "GRASS_BLOCK",
    "world": {"min_y": -64, "height": 2096},
    "elevation": {"heights_config": "heights.json5"},
    "network": {
        "mirrors": {"mirror://terrarium/": "../../fixtures/elevation/terrarium"},
        "memory_cache_tiles": 64,
    },
    "generation": {"queue_capacity": 4096},
    "openstreetmap": {"enabled": false},
}
