// One world-wide terrarium layer served from the local mirror (upstream uses zoom 13 from AWS).
[
    {
        "dataset": {
            "urls": ["mirror://terrarium/12/${x}/${z}.png"],
            "projection": {"web_mercator": {"zoom": 12}},
            "resolution": 256,
            "blend": "CUBIC",
            "parse": {"parse_png_terrarium": {}}
        },
        "bounds": {"minX": -180.0, "maxX": 180.0, "minZ": -85, "maxZ": 85},
        "zooms": {"min": 0, "max": 3},
        "priority": 0.0
    }
]
